# Reconstructed nonsecret configuration. Keep actual values in a private .env.
# The application reads environment variables; it does not load .env by itself.
BOT_OFFLINE=true
TELEGRAM_ADMIN_IDS=
MAIN_BOT_TOKEN=
BOT_USERNAME=
SQL_DATABASE_URL=sqlite:///./telegrambot.db

# Two independent controls are required for real exchange orders.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
BINGX_APIKEY=
BINGX_APISECRET=
BYBIT_APIKEY=
BYBIT_APISECRET=
COINEX_APIKEY=
COINEX_APISECRET=
BINANCE_APIKEY=
BINANCE_APISECRET=

# Authenticated TradingView relay, separately deployed as app:app
FORWARDER_BOT_TOKEN=
TRADINGVIEW_ALERTS_CHANNEL_ID=
FORWARDER_WEBHOOK_SECRET=
FORWARDER_TIMEOUT_SECONDS=10
FORWARDER_MAX_BODY_BYTES=8192
TRADINGVIEW_WEBHOOK_URL=

# Payments and referrals are inactive until explicitly configured and reviewed.
PAYMENTS_ENABLED=false
REFERRALS_ENABLED=false
TRONSCAN_APIKEY=
USDT_TRC20_WALLET_ADDRESS=
OPERATIONS_CHAT_ID=
MONTH1PRICEDOLLAR=
MONTH3PRICEDOLLAR=
MONTH6PRICEDOLLAR=
MONTH12PRICEDOLLAR=
REFERRAL_CASHBACK_PERCENTAGE=
MIN_REFERRAL_WITHDRAW=
MIN_REFERRAL_SUBSCRIBE=
